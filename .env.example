# auto (по умолчанию: OpenAI, затем NVIDIA), openai, nvidia, brev или local
AI_PROVIDER=auto
OPENAI_API_KEY=
NVIDIA_API_KEY=
# Для NVIDIA Build нужен ключ nvapi-…, а не ключ Brev bak-…
# Необязательная замена модели
OPENAI_MODEL=gpt-4o-mini
NVIDIA_MODEL=mistralai/mistral-nemotron

# Только явный brev включает уже запущенный NIM. Auto его не выбирает.
RANKING_PROVIDER=tfidf
# Адреса через локальный SSH-туннель; удалённые адреса должны использовать HTTPS.
NIM_RERANK_BASE_URL=http://127.0.0.1:8002/v1
NIM_RERANK_MODEL=
NIM_RERANK_API_KEY=
NIM_BASE_URL=http://127.0.0.1:8001/v1
NIM_MODEL=
NIM_API_KEY=
# Модели: точные id из /v1/models соответствующего NIM-сервера.
# NIM_*_API_KEY: только токен авторизации workload/proxy, если он настроен.
# Не подставляйте сюда BREV_API_KEY или NGC_API_KEY.
