{
  "openapi": "3.1.0",
  "info": {
    "title": "Умный подбор event-подрядчиков",
    "description": "До трёх проверяемых рекомендаций из каталога HackAlem AI.",
    "version": "0.2.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Successful Response",
            "headers": {
              "X-Request-ID": {
                "description": "Созданный сервером номер запроса для поиска в логах.",
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              },
              "X-Process-Time-Ms": {
                "description": "Время до начала HTTP-ответа в миллисекундах.",
                "schema": {
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "headers": {
              "X-Request-ID": {
                "description": "Созданный сервером номер запроса для поиска в логах.",
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              },
              "X-Process-Time-Ms": {
                "description": "Время до начала HTTP-ответа в миллисекундах.",
                "schema": {
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "headers": {
              "X-Request-ID": {
                "description": "Созданный сервером номер запроса для поиска в логах.",
                "schema": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{32}$"
                }
              },
              "X-Process-Time-Ms": {
                "description": "Время до начала HTTP-ответа в миллисекундах.",
                "schema": {
                  "type": "number",
                  "minimum": 0.0
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
